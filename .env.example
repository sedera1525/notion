# ============================================================
# Modèle de configuration — à copier en « .env » puis remplir.
#   cp .env.example .env
# Le fichier .env n'est JAMAIS committé (voir .gitignore).
# ============================================================

# --- Connexion Notion ---
# Jeton d'intégration interne Notion.
# Où l'obtenir : https://www.notion.so/profile/integrations
#   1. Créer une intégration interne.
#   2. Copier le « Internal Integration Secret » (commence par ntn_).
#   3. Dans Notion, ouvrir la page « H Factory – Démo » puis
#      menu ••• > Connexions > ajouter l'intégration.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identifiant (UUID) de la page racine « H Factory – Démo ».
# Où le trouver : ouvrir la page dans le navigateur, l'URL se termine
# par un identifiant de 32 caractères.
NOTION_PAGE_RACINE_ID=00000000000000000000000000000000

# --- Identifiants des bases (remplis en phase 1) ---
# Notion distingue la « database » (le conteneur) et la « data source » (le schéma).
# Les appels d'API sur les pages et les requêtes utilisent la DATA SOURCE.
NOTION_DB_CLIENTS_ID=
NOTION_DS_CLIENTS_ID=

NOTION_DB_APPELS_OFFRES_ID=
NOTION_DS_APPELS_OFFRES_ID=

NOTION_DB_PROJETS_ID=
NOTION_DS_PROJETS_ID=

NOTION_DB_DOCUMENTATION_ID=
NOTION_DS_DOCUMENTATION_ID=

# --- Exécution planifiée (phase 7) ---
# Dossier surveillé pour les nouveaux rapports à synthétiser.
DOSSIER_ENTREE=./input
# Dossier des sorties locales et du journal.
DOSSIER_SORTIE=./output
